APP_NAME=Telegram Archive
APP_VERSION=0.1.0
ENVIRONMENT=development

HOST=0.0.0.0
PORT=8000

DATABASE_URL=postgresql+asyncpg://archive:archive_dev_password@postgres:5432/telegram_archive

NODE_HEARTBEAT_INTERVAL=15
NODE_TIMEOUT=60

ENROLLMENT_TOKEN_TTL=300

# Generate a unique secret before deployment.
# Never use this example value in production.
APP_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET
